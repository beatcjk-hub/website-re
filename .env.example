# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 Git에 올리지 않는다.
# 모든 값은 서버에서만 사용하므로 NEXT_PUBLIC_ 을 붙이지 않는다.

# Supabase 대시보드 > Project Settings > API
SUPABASE_URL=
# Secret Key (sb_secret_... 형식). Publishable 키와 혼동하지 말 것. 절대 공유/커밋 금지.
SUPABASE_SECRET_KEY=

# (선택) 문의 알림을 받을 웹훅 주소, 향후 n8n
INQUIRY_WEBHOOK_URL=
