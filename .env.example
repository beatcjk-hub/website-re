# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 Git에 올리지 않는다.
# 모든 값은 서버에서만 사용하므로 NEXT_PUBLIC_ 을 붙이지 않는다.

# Supabase 대시보드 > Project Settings > API
SUPABASE_URL=
# Secret Key (sb_secret_... 형식). Publishable 키와 혼동하지 말 것. 절대 공유/커밋 금지.
SUPABASE_SECRET_KEY=
# Publishable Key (sb_publishable_... 형식). 관리자 로그인(이메일 매직 링크)에 사용.
SUPABASE_PUBLISHABLE_KEY=

# 관리자 페이지(/admin) 로그인을 허용할 단 하나의 이메일 주소
ADMIN_EMAIL=
# 로그인 링크가 돌아올 주소. 배포 후에는 https://eb-ds.com 처럼 실제 도메인으로 바꾼다.
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# 상담 문의 이메일 알림 (Resend, https://resend.com). 가입한 이메일 주소로만 받을 수 있다(도메인 인증 전).
RESEND_API_KEY=
# 알림을 받을 이메일 주소
INQUIRY_NOTIFY_EMAIL=
# (선택) 발신 주소. 도메인 인증 후에만 변경 가능. 예: EB-DS <design@eb-ds.com>
INQUIRY_FROM_EMAIL=

# (선택) 문의 알림을 받을 웹훅 주소, 향후 n8n
INQUIRY_WEBHOOK_URL=
